{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": ["src/main.ts", "src/**/*.test.ts"],
    "project": ["src/**/*.ts", "src/**/*.vue"],
    // A type exported but only used inside its own file is fine; report types nothing uses.
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [
        // Known false positives
        "@vueuse/core", // Used in CalibrationWizard.vue but not detected
        "lucide-vue-next", // Tree-shaken icon imports not detected by knip
    ],
}
